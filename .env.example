# Notification Channel (ntfy.sh)
NTFY_TOPIC=your_unique_ntfy_topic_uuid

# Alexa Routine Trigger Webhook URLs (e.g. virtualsmarthome.xyz)
WEBHOOK_ON_URL=https://www.virtualsmarthome.xyz/url_routine_trigger/activate.php?trigger=YOUR_ON_TRIGGER_ID&token=YOUR_ON_TOKEN&response=json
WEBHOOK_OFF_URL=https://www.virtualsmarthome.xyz/url_routine_trigger/activate.php?trigger=YOUR_OFF_TRIGGER_ID&token=YOUR_OFF_TOKEN&response=json

# Battery Automation Thresholds & Limits
CHECK_INTERVAL=60
LOW_BATTERY_THRESHOLD=25
FULL_BATTERY_THRESHOLD=80
CRITICAL_BATTERY_THRESHOLD=15
THERMAL_CUTOFF_TEMP=42.0
ON_COOLDOWN=300
MAX_CHARGING_DURATION=3600
CRITICAL_ALERT_INTERVAL=900
